# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit it.
# See docs/getting-started.md for how to obtain the Google OAuth values.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Required only if you configure a real AI Connection (Settings -> AI Connections) with a stored
# credential. Must be a base64-encoded 32-byte key, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without this set, storing a credential fails closed (no plaintext fallback) — see
# src/lib/ai-connections/crypto.ts.
# AI_CONNECTIONS_ENCRYPTION_KEY=

# Required only if you connect the Google Cloud integration (Settings -> Google Cloud connection).
# Must be a base64-encoded 32-byte key, generated the same way as above -- deliberately a
# SEPARATE key from AI_CONNECTIONS_ENCRYPTION_KEY (docs/AGENTS.md §M, feature-module
# independence). Without this set, connecting fails closed (no plaintext fallback) -- see
# src/lib/cloud-connection/crypto.ts. This connection also requires that
# http://localhost:3000/api/cloud-connection/callback (or your NEXTAUTH_URL's equivalent) be
# added to the OAuth client's own "Authorized redirect URIs" in Google Cloud Console -- it is a
# separate redirect URI from the channel-login one NextAuth already uses.
# CLOUD_CONNECTION_ENCRYPTION_KEY=

# Optional
# CLI_OAUTH_CALLBACK_PORT=8787
# YOUTUBE_TRANSCRIPT_PROVIDER=youtube-captions
# METADATA_GENERATOR_MODE=rule-based
# METADATA_GENERATOR_RAW_OUTPUT={"finalTitle":"...","description":"...","promptVersion":"..."}

# The MCP server (npm run mcp:video-metadata) registers NO tools at all -- not even
# read-only ones -- until the "MCP connection" toggle is turned on in the app's Settings tab.
# There is no environment-variable override for this; it is a persisted, one-time setup toggle
# (src/lib/db.ts's getMcpConnectionEnabled), not something configured here (docs/interfaces.md).
