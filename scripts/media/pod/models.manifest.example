# Comfy-Org/Wan_2.2_ComfyUI_Repackaged	split_files/vae/wan2.2_vae.safetensors	vae
# Comfy-Org/Wan_2.1_ComfyUI_repackaged	split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors	text_encoders
