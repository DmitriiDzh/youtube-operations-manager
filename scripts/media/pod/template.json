{
  "name": "ytm-comfyui",
  "image": "runpod/comfyui:latest",
  "category": "NVIDIA",
  "disk": 20,
  "ports": ["8189/http", "22/tcp"],
  "env": {
    "COMFY_TOKEN": "set-per-session-by-the-app",
    "YTM_POD_START": "/workspace/ytm/pod-start.sh"
  },
  "args": "bash -lc 'bash /workspace/ytm/pod-start.sh'",
  "startSsh": true,
  "startJupyter": false,
  "public": false,
  "serverless": false
}
