{
  "name": "txt2img FLUX.1 schnell (fp8)",
  "description": "Text to image with FLUX.1 schnell fp8 (all-in-one checkpoint models/checkpoints/flux1-schnell-fp8.safetensors, Apache 2.0). 4 steps, cfg 1. Import: npm run media -- workflow-template-import --file scripts/media/workflows/flux-schnell-txt2img.json",
  "workflow": {
    "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "flux1-schnell-fp8.safetensors" } },
    "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "a quiet tropical beach at dawn, soft light", "clip": ["1", 1] } },
    "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] } },
    "4": { "class_type": "EmptySD3LatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 0,
        "steps": 4,
        "cfg": 1,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      }
    },
    "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
    "7": { "class_type": "SaveImage", "inputs": { "filename_prefix": "flux", "images": ["6", 0] } }
  },
  "parameters": [
    { "name": "prompt", "type": "text", "nodeId": "2", "input": "text", "required": true, "min": 1, "max": 4000, "description": "What to draw" },
    { "name": "seed", "type": "integer", "nodeId": "5", "input": "seed", "default": 0, "min": 0, "max": 4294967295, "description": "Random seed (same seed + prompt = same image)" },
    { "name": "steps", "type": "integer", "nodeId": "5", "input": "steps", "default": 4, "min": 1, "max": 8, "description": "Sampling steps (schnell: 4)" },
    { "name": "width", "type": "integer", "nodeId": "4", "input": "width", "default": 1024, "min": 512, "max": 1536, "description": "Width in px (multiple of 64)" },
    { "name": "height", "type": "integer", "nodeId": "4", "input": "height", "default": 1024, "min": 512, "max": 1536, "description": "Height in px (multiple of 64)" }
  ]
}
