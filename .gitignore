# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# OAuth / secrets
data/oauth/
data/tokens/
credentials/
client_secret*.json
token*.json

# local app state
data/backups/
data/imports/
data/exports/
data/logs/

# sqlite
data/*.db
data/*.db-wal
data/*.db-shm

# local auth context
data/auth-context.json

# macOS launcher script's own PID file (scripts/macos/start.sh / stop.sh)
/.launcher.pid

# published/<version>/ snapshots (docs/decisions/0003-published-release-snapshots.md) are
# themselves committed, but anything an operator generates *inside* one after copying it out
# (npm install, npm run build, running the app) must not be — these patterns are unanchored on
# purpose so they match at any published/*/ depth, not just the repo root.
published/*/node_modules/
published/*/.next/
published/*/.launcher.pid
published/*/data/*.db
published/*/data/*.db-wal
published/*/data/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
