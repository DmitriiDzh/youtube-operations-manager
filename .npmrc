# Supply-chain guards (owner request 2026-11-12, TG 4166).
# Install scripts run only for the packages listed in package.json "allowScripts";
# any other dependency with an install script fails the install until it is reviewed
# (`npm approve-scripts --allow-scripts-pending`, then `npm install-scripts approve|deny <pkg>`).
strict-allow-scripts=true
# Resolve only versions published more than 7 days ago (new versions are where hijacked releases land).
min-release-age=7
